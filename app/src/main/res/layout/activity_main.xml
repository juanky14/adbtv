<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingTop="36dp"
    android:paddingEnd="48dp"
    android:paddingBottom="32dp">

    <!-- Columna izquierda: estado y conexión -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_launcher_legacy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/CardLabel"
                android:text="Desde un PC de la red" />

            <TextView
                android:id="@+id/txtAdbCmd"
                style="@style/CardValue" />

            <TextView
                style="@style/CardLabel"
                android:layout_marginTop="16dp"
                android:text="Panel web" />

            <TextView
                android:id="@+id/txtWebUrl"
                style="@style/CardValue" />

            <TextView
                style="@style/CardLabel"
                android:layout_marginTop="16dp"
                android:text="PIN" />

            <TextView
                android:id="@+id/txtPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.18"
                android:textColor="@color/text"
                android:textSize="34sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConnect"
                style="@style/TvButton"
                android:text="Conectar" />

            <Button
                android:id="@+id/btnRoot"
                style="@style/TvButton"
                android:text="Root" />

            <Button
                android:id="@+id/btnNewPin"
                style="@style/TvButton"
                android:text="Nuevo PIN" />

            <Button
                android:id="@+id/btnHome"
                style="@style/TvButton"
                android:text="Inicio" />

            <Button
                android:id="@+id/btnStop"
                style="@style/TvButton"
                android:layout_marginEnd="0dp"
                android:text="Detener" />
        </LinearLayout>
    </LinearLayout>

    <!-- Columna derecha: registro -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="28dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            style="@style/CardLabel"
            android:text="Registro" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:scrollbars="none">

            <TextView
                android:id="@+id/txtLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="#AEB5BD"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
